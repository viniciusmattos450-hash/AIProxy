{
  "manifest_version": 2,
  "name": "DeepSeek Bridge",
  "version": "1.0",
  "description": "Executa blocos [SCRIPT] localmente com sandbox",
  "content_scripts": [{
    "matches": ["https://chat.deepseek.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "background": {
    "scripts": ["bg.js"]
  },
  "permissions": [
    "http://127.0.0.1:8765/*",
    "storage"
  ]
}